api:A_CHECK_CLI | name="agentspk-check CLI"; summary="validates atomsets for parse errors duplicates broken relations missing references and isolated atoms"; protocol="cli"; version="1" | ref:file:"skills/check-spk/scripts/agentspk-check",file:"skills/check-spk/scripts/agentspk-check.ps1"
api:A_SEARCH_CLI | name="agentspk-search CLI"; summary="loads atoms by selector text or full scan and can traverse related neighbors"; protocol="cli"; version="1" | ref:file:"skills/search-spk/scripts/agentspk-search",file:"skills/search-spk/scripts/agentspk-search.ps1"
api:A_WRITE_CLI | name="agentspk-write CLI"; summary="creates or intentionally replaces atoms and rewrites managed spk files"; protocol="cli"; version="1" | ref:file:"skills/write-spk/scripts/agentspk-write",file:"skills/write-spk/scripts/agentspk-write.ps1"
arc:AR_SOURCE_REPOSITORY | style="documentation plus bundled shell tooling"; nodes="docs, skill packages, shell CLIs, PowerShell launchers, install guide, example atomset, spec files"; flow="agent -> skill docs -> CLI entrypoints -> spk files"; notes="this repository self-hosts AgentSPK and uses skills from the root skills directory" | rel:defines:cmp:C_WRITE_SKILL,defines:cmp:C_SEARCH_SKILL,defines:cmp:C_CHECK_SKILL,defines:cmp:C_INSTALL_GUIDE,defines:cmp:C_CART_EXAMPLE,defines:api:A_WRITE_CLI,defines:api:A_SEARCH_CLI,defines:api:A_CHECK_CLI,defines:dat:D_SPK_ATOMSET | ref:doc:"AGENTS.md"
beh:B_CHECK_ATOMS | when="an agent validates the atomset"; then="the checker reports malformed atoms duplicate definitions missing relation targets missing reference paths and atoms with no relations"; notes="validation issues are reported in JSON instead of as a hard shell failure" | rel:uses:api:A_CHECK_CLI,uses:dat:D_SPK_ATOMSET
beh:B_SEARCH_ATOMS | when="an agent needs specification context"; then="the search workflow scans repo spk files and returns direct matches plus optional incoming and outgoing related atoms up to a requested depth"; notes="selectors match type:id globs and text search uses regex against raw atom lines" | rel:uses:api:A_SEARCH_CLI,uses:dat:D_SPK_ATOMSET
beh:B_WRITE_ATOMS | when="an agent records durable specification knowledge"; then="the writer stores atoms in spec/specifications.spk by default, sorts managed atoms by type and id, and refuses duplicate type/id writes unless replace is explicit"; notes="an intentional replace can also move an existing atom into a different target file" | rel:uses:api:A_WRITE_CLI,affects:dat:D_SPK_ATOMSET
chg:CH_SELF_HOSTING_LAYOUT | change="the source repository consumes AgentSPK skill packages directly from skills/<skill-name>/ instead of an installed .agents layout"; reason="this repository is AgentSPK itself rather than only a downstream consumer"; scope="repository conventions"; notes="INSTALL_AGENTSPK.md still tells downstream repositories to install the skills under .agents/skills" | rel:affects:arc:AR_SOURCE_REPOSITORY,affects:cmp:C_INSTALL_GUIDE
cmp:C_CART_EXAMPLE | name="Cart Example Atomset"; kind="example"; responsibility="show a concrete SPK file and referenced OpenAPI document for a save-for-later cart capability" | ref:file:"examples/cart/cart.spk",openapi:"examples/cart/cart.openapi.yaml"
cmp:C_CHECK_SKILL | name="Check SPK Skill Package"; kind="skill-package"; responsibility="document and bundle the workflow for validating parse duplicate relation reference and isolation issues" | rel:uses:api:A_CHECK_CLI | ref:doc:"skills/check-spk/SKILL.md"
cmp:C_INSTALL_GUIDE | name="Installation Guide"; kind="doc"; responsibility="tell another agent how to install AgentSPK skills and AGENTS.md guidance into a target repository" | rel:uses:cmp:C_WRITE_SKILL,uses:cmp:C_SEARCH_SKILL,uses:cmp:C_CHECK_SKILL | ref:doc:"INSTALL_AGENTSPK.md"
cmp:C_SEARCH_SKILL | name="Search SPK Skill Package"; kind="skill-package"; responsibility="document and bundle the workflow for loading atoms by selector text or related context" | rel:uses:api:A_SEARCH_CLI | ref:doc:"skills/search-spk/SKILL.md"
cmp:C_WRITE_SKILL | name="Write SPK Skill Package"; kind="skill-package"; responsibility="document and bundle the workflow for creating replacing and moving atoms" | rel:uses:api:A_WRITE_CLI | ref:doc:"skills/write-spk/SKILL.md"
dat:D_SPK_ATOMSET | name="SPK Atomset"; summary="project specification stored as one-line atoms across repo-root-relative spk files"; kind="specification"; storage="git" | ref:doc:"docs/specification-model.md",doc:"docs/spk-format.md"
fea:F_DOWNSTREAM_INSTALLATION | name="Downstream Repository Installation"; summary="provides copy-based instructions for installing AgentSPK skills and AGENTS.md guidance into another repository" | rel:uses:cmp:C_INSTALL_GUIDE,uses:cmp:C_WRITE_SKILL,uses:cmp:C_SEARCH_SKILL,uses:cmp:C_CHECK_SKILL | ref:doc:"INSTALL_AGENTSPK.md"
fea:F_SKILL_PACKAGED_WORKFLOWS | name="Skill-packaged Specification Workflows"; summary="bundles repo-local write search and check capabilities as skill packages with CLIs for agents" | rel:requires:beh:B_WRITE_ATOMS,requires:beh:B_SEARCH_ATOMS,requires:beh:B_CHECK_ATOMS,uses:cmp:C_WRITE_SKILL,uses:cmp:C_SEARCH_SKILL,uses:cmp:C_CHECK_SKILL | ref:doc:"README.md"
fea:F_SPK_ATOM_FORMAT | name="SPK Atom Format"; summary="represents project specifications as one-line atoms with typed ids bodies relations and optional references" | rel:uses:dat:D_SPK_ATOMSET,uses:cmp:C_CART_EXAMPLE | ref:doc:"README.md",doc:"docs/spk-format.md"
goal:G_DURABLE_SPEC_MEMORY | outcome="preserve implementation-relevant project knowledge across agent sessions"; metric="spec recovery"; target="agents can reload durable intent behavior constraints and history from repo files"; reason="AI coding sessions lose or compress transient context"
goal:G_PREDICTABLE_TOOLING | outcome="give agents predictable repo-local specification workflows"; metric="workflow automation"; target="write search and check flows return deterministic file changes and machine-readable results"; reason="agents need scripts they can invoke without bespoke integration"
grp:GRP_AGENTSPK_CORE | name="AgentSPK Core"; summary="core product tooling and repository-convention atoms for the source repository"; scope="source repository" | rel:belongs:goal:G_DURABLE_SPEC_MEMORY,belongs:goal:G_PREDICTABLE_TOOLING,belongs:upn:P_AI_CODING_AGENT,belongs:uss:U_RELOAD_SPEC_CONTEXT,belongs:uss:U_AUTOMATE_SPEC_WORKFLOWS,belongs:fea:F_SPK_ATOM_FORMAT,belongs:fea:F_SKILL_PACKAGED_WORKFLOWS,belongs:fea:F_DOWNSTREAM_INSTALLATION,belongs:beh:B_WRITE_ATOMS,belongs:beh:B_SEARCH_ATOMS,belongs:beh:B_CHECK_ATOMS,belongs:cmp:C_WRITE_SKILL,belongs:cmp:C_SEARCH_SKILL,belongs:cmp:C_CHECK_SKILL,belongs:cmp:C_INSTALL_GUIDE,belongs:cmp:C_CART_EXAMPLE,belongs:api:A_WRITE_CLI,belongs:api:A_SEARCH_CLI,belongs:api:A_CHECK_CLI,belongs:dat:D_SPK_ATOMSET,belongs:arc:AR_SOURCE_REPOSITORY,belongs:nfr:N_DETERMINISTIC_AGENT_WORKFLOWS,belongs:tcn:T_POSIX_PRIMARY_IMPLEMENTATION,belongs:tcn:T_DEFAULT_SPEC_LOCATION,belongs:tds:T_EXPLICIT_REPLACEMENT,belongs:tds:T_JSON_SOURCE_OF_TRUTH,belongs:chg:CH_SELF_HOSTING_LAYOUT
nfr:N_DETERMINISTIC_AGENT_WORKFLOWS | concern="predictability"; rule="spec workflows should produce stable ordering and machine-readable results for agents"; metric="workflow outputs"; target="deterministic rewrites and JSON reports across bundled CLIs" | rel:affects:api:A_WRITE_CLI,affects:api:A_SEARCH_CLI,affects:api:A_CHECK_CLI
tcn:T_DEFAULT_SPEC_LOCATION | scope="spec storage"; rule="writes default to spec/specifications.spk and atom references should use repo-root-relative paths"; reason="consistent locations let tools rewrite files and validate references predictably" | rel:affects:dat:D_SPK_ATOMSET,affects:api:A_WRITE_CLI
tcn:T_POSIX_PRIMARY_IMPLEMENTATION | scope="tooling"; rule="canonical AgentSPK CLIs are POSIX shell scripts and Windows entrypoints delegate through bash sh or WSL"; reason="one shared implementation keeps behavior aligned across platforms" | rel:affects:api:A_WRITE_CLI,affects:api:A_SEARCH_CLI,affects:api:A_CHECK_CLI
tds:T_EXPLICIT_REPLACEMENT | decision="duplicate type/id writes require an explicit replace flag before an existing atom is changed or moved"; reason="spec updates should be intentional and safe for automation"; tradeoff="agents cannot casually overwrite existing atoms" | rel:affects:api:A_WRITE_CLI,affects:beh:B_WRITE_ATOMS
tds:T_JSON_SOURCE_OF_TRUTH | decision="search write and check CLIs return machine-readable JSON as the authoritative result"; reason="agents need reliable outputs for follow-up actions"; tradeoff="human explanation is handled primarily in README and SKILL.md files" | rel:affects:api:A_WRITE_CLI,affects:api:A_SEARCH_CLI,affects:api:A_CHECK_CLI
upn:P_AI_CODING_AGENT | name="AI Coding Agent"; summary="operates inside a repository with limited session context and tool access"; traits="context-limited, automation-oriented, repo-local"
uss:U_AUTOMATE_SPEC_WORKFLOWS | as="AI coding agent"; want="use repo-local search write and check workflows"; because="I need predictable commands instead of one-off conventions" | rel:requires:goal:G_PREDICTABLE_TOOLING,requires:fea:F_SKILL_PACKAGED_WORKFLOWS,requires:upn:P_AI_CODING_AGENT
uss:U_RELOAD_SPEC_CONTEXT | as="AI coding agent"; want="reload durable project intent and implementation context from repo-native spec files"; because="session memory can be partial or lost" | rel:requires:goal:G_DURABLE_SPEC_MEMORY,requires:fea:F_SPK_ATOM_FORMAT,requires:upn:P_AI_CODING_AGENT