# api
api:A_AGENTSPK_CLIS | name="AgentSPK CLIs"; summary="repo-local write search and check commands for creating replacing deleting loading and validating atoms"; protocol="cli"; version="1" | ref:file:"skills/write-spk/scripts/agentspk-write",file:"skills/write-spk/scripts/agentspk-write.ps1",file:"skills/search-spk/scripts/agentspk-search",file:"skills/search-spk/scripts/agentspk-search.ps1",file:"skills/check-spk/scripts/agentspk-check",file:"skills/check-spk/scripts/agentspk-check.ps1"

# arc
arc:AR_SOURCE_REPOSITORY | style="documentation plus bundled shell tooling"; nodes="docs, skill packages, shell CLIs, PowerShell launchers, install and upgrade guide, example atomset, sectioned spec file"; flow="agent -> skill docs -> CLI entrypoints -> spk files"; notes="this repository self-hosts AgentSPK and uses skills from the root skills directory" | rel:defines:cmp:C_AGENTSPK_SKILLS,defines:cmp:C_INSTALL_GUIDE,defines:cmp:C_CART_EXAMPLE,defines:api:A_AGENTSPK_CLIS,defines:dat:D_SPK_ATOMSET | ref:doc:"AGENTS.md"

# beh
beh:B_AGENTSPK_WORKFLOWS | when="an agent uses AgentSPK"; then="search only when durable context is missing write compact specification-changing knowledge and check only when the atomset may be inconsistent or spec/specifications.spk was manually edited"; notes="write defaults to sectioned spec/specifications.spk sorted by type/id and normal write CLI operations do not require an immediate manual check and downstream upgrades replace skill dirs update AGENTS.md preserve atoms and verify CLIs" | rel:uses:api:A_AGENTSPK_CLIS,uses:dat:D_SPK_ATOMSET,uses:cmp:C_AGENTSPK_SKILLS,uses:cmp:C_INSTALL_GUIDE

# chg
chg:CH_SELF_HOSTING_LAYOUT | change="the source repository consumes AgentSPK skill packages directly from skills/<skill-name>/ instead of an installed .agents layout"; reason="this repository is AgentSPK itself rather than only a downstream consumer"; scope="repository conventions"; notes="INSTALL_AGENTSPK.md still tells downstream repositories to install the skills under .agents/skills" | rel:affects:arc:AR_SOURCE_REPOSITORY,affects:cmp:C_INSTALL_GUIDE

# cmp
cmp:C_AGENTSPK_SKILLS | name="AgentSPK Skill Packages"; kind="skill-package"; responsibility="document and bundle write search and check workflows with POSIX CLIs and PowerShell launchers" | rel:uses:api:A_AGENTSPK_CLIS | ref:doc:"skills/write-spk/SKILL.md",doc:"skills/search-spk/SKILL.md",doc:"skills/check-spk/SKILL.md"
cmp:C_CART_EXAMPLE | name="Cart Example Atomset"; kind="example"; responsibility="show a concrete SPK file and referenced OpenAPI document for a save-for-later cart capability" | ref:file:"examples/cart/cart.spk",openapi:"examples/cart/cart.openapi.yaml"
cmp:C_INSTALL_GUIDE | name="Installation and Upgrade Guide"; kind="doc"; responsibility="tell agents how to install or upgrade skill packages and AGENTS.md guidance in downstream repositories" | rel:uses:cmp:C_AGENTSPK_SKILLS | ref:doc:"INSTALL_AGENTSPK.md"

# dat
dat:D_SPK_ATOMSET | name="SPK Atomset"; summary="repo-root-relative spk files containing one atom per line with optional type section headers relations and refs"; kind="specification"; storage="git" | rel:uses:cmp:C_CART_EXAMPLE | ref:doc:"docs/specification-model.md",doc:"docs/spk-format.md"

# fea
fea:F_DOWNSTREAM_INSTALLATION | name="Downstream Installation and Upgrade"; summary="copy AgentSPK skills into .agents/skills update the AgentSPK AGENTS.md section preserve existing atoms and verify all CLI entrypoints" | rel:uses:cmp:C_INSTALL_GUIDE,uses:cmp:C_AGENTSPK_SKILLS,uses:api:A_AGENTSPK_CLIS | ref:doc:"INSTALL_AGENTSPK.md"

# goal
goal:G_AGENTSPK_DURABLE_MEMORY | outcome="preserve implementation-relevant project knowledge across agent sessions"; metric="spec recovery and workflow automation"; target="agents reload durable intent and use predictable repo-local workflows without external memory"; reason="AI coding sessions lose or compress transient context"

# grp
grp:GRP_AGENTSPK_CORE | name="AgentSPK Core"; summary="core source repository atoms for durable spec memory tooling installation and conventions"; scope="source repository" | rel:belongs:goal:G_AGENTSPK_DURABLE_MEMORY,belongs:upn:P_AI_CODING_AGENT,belongs:uss:U_AGENT_SPEC_MEMORY,belongs:fea:F_DOWNSTREAM_INSTALLATION,belongs:beh:B_AGENTSPK_WORKFLOWS,belongs:cmp:C_AGENTSPK_SKILLS,belongs:cmp:C_INSTALL_GUIDE,belongs:cmp:C_CART_EXAMPLE,belongs:api:A_AGENTSPK_CLIS,belongs:dat:D_SPK_ATOMSET,belongs:arc:AR_SOURCE_REPOSITORY,belongs:nfr:N_DETERMINISTIC_AGENT_WORKFLOWS,belongs:tcn:T_POSIX_PRIMARY_IMPLEMENTATION,belongs:tds:T_SPEC_MEMORY_DISCIPLINE,belongs:tds:T_TOOLING_CONTRACTS,belongs:chg:CH_SELF_HOSTING_LAYOUT

# nfr
nfr:N_DETERMINISTIC_AGENT_WORKFLOWS | concern="predictability"; rule="spec workflows should produce stable ordering machine-readable results and sectioned default storage"; metric="workflow outputs and merge behavior"; target="deterministic JSON reports and type-sectioned spec/specifications.spk rewrites" | rel:affects:api:A_AGENTSPK_CLIS,affects:dat:D_SPK_ATOMSET

# tcn
tcn:T_POSIX_PRIMARY_IMPLEMENTATION | scope="tooling"; rule="canonical AgentSPK CLIs are POSIX shell scripts and Windows entrypoints delegate through bash sh or WSL"; reason="one shared implementation keeps behavior aligned across platforms" | rel:affects:api:A_AGENTSPK_CLIS
tcn:T_REPOSITORY_TEST_DISCIPLINE | scope="testing"; rule="after modifying this repository agents must run tests/run.sh and ensure it passes and new features behaviors interfaces tooling changes and bug fixes must include corresponding tests"; reason="self-hosting AgentSPK changes need executable regression coverage" | rel:affects:beh:B_AGENTSPK_WORKFLOWS,affects:nfr:N_DETERMINISTIC_AGENT_WORKFLOWS | ref:file:"tests/run.sh",doc:"AGENTS.md"

# tds
tds:T_SPEC_MEMORY_DISCIPLINE | decision="agents search AgentSPK only when context lacks durable specification knowledge and write only compact specification-changing knowledge"; reason="AgentSPK is durable specification memory not a per-turn cache check or activity log"; tradeoff="agents rely on conversation inspected source and loaded atoms between searches" | rel:affects:beh:B_AGENTSPK_WORKFLOWS,affects:dat:D_SPK_ATOMSET | ref:doc:"AGENTS.md",doc:"skills/search-spk/SKILL.md",doc:"skills/write-spk/SKILL.md"
tds:T_TOOLING_CONTRACTS | decision="CLIs return JSON writer requires --replace for duplicates requires exact --delete type:id selectors for removals and default writes render spec/specifications.spk as type sections sorted by type/id"; reason="agents need safe deterministic operations and one grep-friendly spec location"; tradeoff="same-type concurrent edits can still conflict and must preserve intended atom lines" | rel:affects:api:A_AGENTSPK_CLIS,affects:beh:B_AGENTSPK_WORKFLOWS,affects:dat:D_SPK_ATOMSET | ref:file:"skills/write-spk/scripts/agentspk-write",doc:"docs/spk-format.md"

# upn
upn:P_AI_CODING_AGENT | name="AI Coding Agent"; summary="operates inside a repository with limited session context and tool access"; traits="context-limited, automation-oriented, repo-local"

# uss
uss:U_AGENT_SPEC_MEMORY | as="AI coding agent"; want="reload durable project intent and use repo-local specification workflows"; because="I need compact trusted context and predictable commands across sessions" | rel:requires:goal:G_AGENTSPK_DURABLE_MEMORY,requires:upn:P_AI_CODING_AGENT,requires:beh:B_AGENTSPK_WORKFLOWS
